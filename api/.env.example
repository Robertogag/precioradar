# Copia este archivo como ".env" y llena lo que tengas. Sin llaves, esa tienda aparece como "Falta conectarla".

# Mercado Libre: registra una aplicación en https://developers.mercadolibre.com.mx y pega aquí sus llaves.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# Puerto del servidor y espera máxima por tienda (milisegundos). En Cloud Run el puerto lo pone Google (PORT=8080).
PORT=4000
STORE_TIMEOUT_MS=15000

# --- Seguridad -------------------------------------------------------------------------------------------------
# Orígenes (navegadores) con permiso de llamar a la API, separados por coma. Vacío = modo desarrollo: solo
# localhost y la red local. En producción pon el dominio de la web, por ejemplo https://comparador.midominio.com
ALLOWED_ORIGINS=
# 1 si el servidor está detrás de un proxy que pone X-Forwarded-For (Cloud Run, un balanceador). Así el límite
# de peticiones por IP ve la IP real y no la del proxy. En esta PC déjalo en 0.
TRUST_PROXY=0
# Límites por IP y por minuto. La búsqueda consulta a todas las tiendas, por eso su límite es aparte y más bajo.
RATE_LIMIT_PER_MINUTE=120
SEARCHES_PER_MINUTE=30
# Nivel de bitácora: info | warn | error
LOG_LEVEL=info

# --- Base de datos (Cloud SQL · Postgres) ----------------------------------------------------------------------
# Vacío = sin base: todo funciona igual, pero lo que la gente busca no se recuerda entre reinicios.
# Con contraseña y host:   postgres://comparador:CLAVE@10.0.0.5:5432/comparador
# En Cloud Run (socket):   postgres://comparador:CLAVE@localhost/comparador?host=/cloudsql/PROYECTO:REGION:INSTANCIA
# La clave va en Secret Manager, nunca en este archivo ni en el código.
DATABASE_URL=
# Solo si te conectas por IP pública con TLS: 1 verifica el certificado con las CA del sistema;
# DATABASE_SSL_CA apunta al server-ca.pem que descarga Cloud SQL. Por socket de Cloud SQL no hace falta nada.
DATABASE_SSL=0
DATABASE_SSL_CA=

# --- App web -----------------------------------------------------------------------------------------------------
# Carpeta con la web compilada (cd web && npm run build). Vacío = ../web/dist si existe.
WEB_DIST=

# --- Carril de navegador (Coppel y Sears) ------------------------------------------------------------------------
# Se usa solo si hay Chromium: en Cloud Run lo trae la imagen de Playwright; en esta PC se busca en %LOCALAPPDATA%ms-playwright
# o en PLAYWRIGHT_CHROMIUM. BROWSER_STORES_OFF=1 lo apaga; BROWSER_CONCURRENCY = pestañas a la vez (2).
BROWSER_STORES_OFF=0
BROWSER_CONCURRENCY=2
PLAYWRIGHT_CHROMIUM=
